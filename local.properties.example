# Copy to local.properties and fill real values.
# local.properties is gitignored — keys stay masked out of git.

sdk.dir=/path/to/Android/sdk

# RailRadar (required for live train search)
railradar.api.key=rg_xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay test keys (client-side demo mode — no backend needed)
razorpay.key.id=rzp_test_XXXXXXXX
razorpay.key.secret=XXXXXXXXXXXXXXXX

# true = use masked keys in app (no backend). false = call backend for payments.
use.local.keys=true

# Optional backend URL if use.local.keys=false
# backend.base.url=http://10.0.2.2:8088
